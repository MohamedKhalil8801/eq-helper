{
  "version": 1,
  "apps": [
    {
      "id": "equalizer-apo",
      "name": "Equalizer APO",
      "description": "System-wide equalizer for Windows; everything you play goes through it.",
      "platforms": [
        "windows"
      ],
      "device_kind": "computer",
      "links": {
        "site": "https://sourceforge.net/projects/equalizerapo/"
      },
      "price": "free",
      "scope": "system",
      "lr": "full",
      "balance_control": false,
      "formats": [
        {
          "format": "graphic_eq",
          "options": {}
        },
        {
          "format": "convolution",
          "label": "Convolution (optional)",
          "options": {
            "packaging": "stereo_single_rate",
            "sample_rate": "device"
          }
        }
      ],
      "setup_steps": [
        "Install Equalizer APO and select your headphone output in its Configurator, then restart Windows.",
        "Use “Apply to Equalizer APO” in this app, or copy the exported file into C:\\Program Files\\EqualizerAPO\\config and add “Include: <file>” to config.txt.",
        "For the convolution file: add “Convolution: <file>.wav” instead; it only works at the sample rate in its name."
      ],
      "detection": {
        "windows": {
          "paths": [
            "%ProgramFiles%\\EqualizerAPO\\Editor.exe",
            "%ProgramFiles%\\EqualizerAPO\\Configurator.exe"
          ],
          "registry_uninstall": [
            "EqualizerAPO"
          ]
        }
      },
      "verified": false
    },
    {
      "id": "peace",
      "name": "Peace",
      "description": "Friendly interface for Equalizer APO on Windows.",
      "platforms": [
        "windows"
      ],
      "device_kind": "computer",
      "links": {
