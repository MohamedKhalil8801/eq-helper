      "lr": "full",
      "balance_control": true,
      "formats": [
        {
          "format": "parametric",
          "options": {
            "writer": "apo_filters",
            "limits": {
              "max_filters": 20,
              "gain_range": [
                -30,
                30
              ],
              "q_range": [
                0.1,
                20
              ]
            }
          }
        }
      ],
      "setup_steps": [
        "Install Equalizer APO first, then Peace.",
        "In Peace choose Import, pick the exported file, then Save."
      ],
      "detection": {
        "windows": {
          "paths": [
            "%ProgramFiles%\\EqualizerAPO\\config\\Peace.exe"
          ],
          "registry_uninstall": [
            "Peace"
          ]
        }
      },
      "verified": false
    },
