        {
          "format": "convolution",
          "options": {
            "packaging": "stereo_single_rate",
            "sample_rate": "device"
          }
        },
        {
          "format": "parametric",
          "label": "Parametric (Equalizer effect)",
          "options": {
            "writer": "apo_filters",
            "limits": {
              "max_filters": 32
            }
          }
        }
      ],
      "setup_steps": [
        "Add the Convolver effect to Output and import the exported .wav.",
        "Tip: pin PipeWire to one rate (default.clock.rate) so the file's rate always matches.",
        "Parametric: add the Equalizer effect, enable Split channels and use Import APO preset."
      ],
      "detection": {
        "linux": {
          "commands": [
            "easyeffects"
          ],
          "flatpak": [
            "com.github.wwmm.easyeffects"
          ]
        }
      },
      "verified": false
    },
